@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix kg: <https://knuckles-team.github.io/ontology/connector/caddy#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix cd: <http://knuckles.team/kg/caddy-access#> .

cd:routeAccess a ac:AccessContract ;
    ac:classIri core:Route ;
    ac:sourceId "caddy-mcp" ;
    ac:entity "route" ;
    ac:keyField "address" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "caddy_get_reverse_proxy_upstreams" ;
    ac:pagination "none" .

cd:upstreamAddress a ac:PropertyBinding ;
    ac:contract cd:routeAccess ; ac:property kg:upstreamAddress ; ac:field "address" .
